# FlyBy by Feldrix — Frontend Environment Variables
# Copy this file to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenWeatherMap (free key from openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=

# DJI Cloud Backend URL
# Local development: http://localhost:3002
# Production: https://flyby-prod.onrender.com
VITE_DJI_BACKEND_URL=http://localhost:3002
